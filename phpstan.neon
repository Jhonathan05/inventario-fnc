includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - routes

    # Nivel de análisis (0 = suelto, 9 = estricto). Nivel 1 cubre variables,
    # relaciones de Eloquent y tipos básicos; se sube de forma gradual.
    level: 1

    # Sin `ignoreErrors`: el objetivo es 0 errores. Para que larastan resuelva
    # las relaciones de Eloquent, los métodos de relación deben declarar su
    # tipo de retorno nativo (BelongsTo, HasMany, MorphMany, ...).
